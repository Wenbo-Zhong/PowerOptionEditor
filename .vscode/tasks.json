{
  "version": "2.0.0",
  "tasks": [{
    "label": "Build Release x64 (.NET 4.0)",
    "type": "shell",
    "command": "powershell.exe",
    "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1", "-Configuration", "Release"],
    "options": { "cwd": "${workspaceFolder}" },
    "group": { "kind": "build", "isDefault": true },
    "problemMatcher": "$msCompile"
  }]
}
