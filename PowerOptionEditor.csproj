<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <ProjectGuid>{61493B82-062C-445E-A433-84502B7A28EF}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>PowerOptionEditor</RootNamespace>
    <AssemblyName>PowerOptionEditor</AssemblyName>
    <TargetFrameworkVersion>v4.0</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WarningLevel>4</WarningLevel>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Compile Include="Program.cs" />
    <Compile Include="Ui.cs" />
    <Compile Include="AppTheme.cs" />
    <Compile Include="ProfileCatalog.cs" />
    <EmbeddedResource Include="locales\*.xml">
      <LogicalName>PowerOptionEditor.Locales.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <None Include="locales\README.md" />
    <None Include="scripts\validate-locales.py" />
    <None Include="app.manifest" />
    <None Include="README.md" />
    <None Include="LICENSE" />
  </ItemGroup>
  <Target Name="ValidateCompatibilityTarget" BeforeTargets="BeforeBuild">
    <Error Condition="'$(TargetFrameworkVersion)' != 'v4.0'" Text="Server 2003 compatibility requires .NET Framework 4.0." />
    <Error Condition="'$(Platform)' != 'x64' Or '$(PlatformTarget)' != 'x64'" Text="Only x64 builds are supported." />
  </Target>
  <Target Name="RequireReferenceAssemblies" AfterTargets="GetReferenceAssemblyPaths">
    <Error Condition="!Exists('$(_TargetFrameworkDirectories)\RedistList\FrameworkList.xml') And !Exists('$(FrameworkPathOverride)\RedistList\FrameworkList.xml')" Text="Install .NET Framework 4.0 reference assemblies or pass /p:FrameworkPathOverride=PATH. Building against the current machine runtime is not allowed." />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
